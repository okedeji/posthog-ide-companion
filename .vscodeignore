# Editor and IDE
.vscode/**
.claude/**

# Source and tests (users get the bundled dist/)
src/**
__mocks__/**

# Dependencies (bundled into dist/extension.js by esbuild)
node_modules/**

# Build tooling and config
.gitignore
.eslintrc.json
eslint.config.mjs
.prettierrc
tsconfig.json
esbuild.mjs
jest.config.*
.husky/**
CLAUDE.md

# Test artifacts
.vscode-test/**
coverage/**

# Docs images (referenced via GitHub URLs in README)
docs/**

# Lock file (not needed at runtime)
pnpm-lock.yaml

# Sourcemaps and raw TypeScript
**/*.map
**/*.ts

# Explicitly include the bundled output
!dist/extension.js
