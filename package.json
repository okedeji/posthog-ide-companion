{
  "name": "posthog-ide-companion",
  "displayName": "IDE Companion for PostHog",
  "description": "Bring PostHog into your editor. Monitor errors, manage feature flags, query analytics, and get AI-powered fixes without leaving VS Code.",
  "version": "0.2.1",
  "publisher": "tobiokedeji",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/okedeji/posthog-ide-companion.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "resources/icon.png",
  "author": {
    "name": "Tobi Okedeji"
  },
  "keywords": [
    "posthog",
    "analytics",
    "feature-flags",
    "error-tracking",
    "dashboards",
    "ai"
  ],
  "categories": [
    "Data Science",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "authentication": [
      {
        "id": "posthog",
        "label": "PostHog"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "posthog",
          "title": "PostHog",
          "icon": "resources/posthog-icon.svg"
        }
      ]
    },
    "views": {
      "posthog": [
        {
          "id": "posthog.welcome",
          "name": "PostHog",
          "icon": "resources/posthog-icon.svg",
          "when": "!posthog.authenticated || !posthog.projectSelected"
        },
        {
          "id": "posthog.discoveries",
          "name": "Discoveries",
          "icon": "resources/posthog-icon.svg",
          "when": "posthog.authenticated && posthog.projectSelected"
        },
        {
          "id": "posthog.status",
          "name": "Project",
          "icon": "resources/posthog-icon.svg",
          "when": "posthog.authenticated && posthog.projectSelected",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "posthog.welcome",
        "contents": "Sign in to PostHog to monitor errors and get AI-powered fixes.\n[Sign In](command:posthog.signIn)",
        "when": "!posthog.authenticated"
      },
      {
        "view": "posthog.welcome",
        "contents": "Select a project to get started.\n[Select Project](command:posthog.selectProject)",
        "when": "posthog.authenticated && !posthog.projectSelected"
      },
      {
        "view": "posthog.discoveries",
        "contents": "No issues detected yet.\n[Refresh Now](command:posthog.refreshDiscoveries)",
        "when": "posthog.authenticated && posthog.projectSelected"
      }
    ],
    "commands": [
      {
        "command": "posthog.signIn",
        "title": "PostHog: Sign In"
      },
      {
        "command": "posthog.signOut",
        "title": "PostHog: Sign Out",
        "icon": "$(sign-out)"
      },
      {
        "command": "posthog.selectProject",
        "title": "PostHog: Change Project",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "posthog.configureAI",
        "title": "PostHog: Configure AI Provider",
        "icon": "$(hubot)"
      },
      {
        "command": "posthog.openDashboard",
        "title": "PostHog: Open in PostHog",
        "icon": "$(link-external)"
      },
      {
        "command": "posthog.detectWorkspace",
        "title": "PostHog: Refresh Workspace Detection",
        "icon": "$(refresh)"
      },
      {
        "command": "posthog.refreshDiscoveries",
        "title": "PostHog: Refresh Discoveries",
        "icon": "$(refresh)"
      },
      {
        "command": "posthog.openChat",
        "title": "PostHog: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "posthog.investigateDiscovery",
        "title": "PostHog: Investigate"
      },
      {
        "command": "posthog.dismissDiscovery",
        "title": "PostHog: Dismiss Discovery",
        "icon": "$(close)"
      },
      {
        "command": "posthog.switchWorkspacePath",
        "title": "PostHog: Switch Directory",
        "icon": "$(folder-opened)"
      },
      {
        "command": "posthog.sendToChat",
        "title": "PostHog: Send to Chat",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "posthog.openChat",
          "when": "view == posthog.status",
          "group": "navigation@1"
        },
        {
          "command": "posthog.selectProject",
          "when": "view == posthog.status",
          "group": "navigation@2"
        },
        {
          "command": "posthog.configureAI",
          "when": "view == posthog.status",
          "group": "navigation@3"
        },
        {
          "command": "posthog.switchWorkspacePath",
          "when": "view == posthog.status",
          "group": "navigation@4"
        },
        {
          "command": "posthog.detectWorkspace",
          "when": "view == posthog.status",
          "group": "navigation@5"
        },
        {
          "command": "posthog.openDashboard",
          "when": "view == posthog.status",
          "group": "navigation@6"
        },
        {
          "command": "posthog.signOut",
          "when": "view == posthog.status",
          "group": "navigation@7"
        },
        {
          "command": "posthog.refreshDiscoveries",
          "when": "view == posthog.discoveries",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "posthog.dismissDiscovery",
          "when": "view == posthog.discoveries && !(viewItem =~ /^group:/)",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "posthog.sendToChat",
          "when": "editorHasSelection && posthog.authenticated && posthog.projectSelected",
          "group": "posthog@1"
        }
      ],
      "commandPalette": [
        {
          "command": "posthog.investigateDiscovery",
          "when": "false"
        },
        {
          "command": "posthog.dismissDiscovery",
          "when": "false"
        },
        {
          "command": "posthog.sendToChat",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "posthog.sendToChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus && editorHasSelection && posthog.authenticated && posthog.projectSelected"
      }
    ],
    "configuration": {
      "title": "PostHog",
      "properties": {
        "posthog.workspacePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Subdirectory to treat as the workspace root (e.g. `web` or `packages/app`). Useful for monorepos. Leave empty to use the full workspace folder.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "compile": "pnpm check-types && node esbuild.mjs",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "build": "pnpm check-types && node esbuild.mjs --production",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "check-types": "tsc --noEmit",
    "package": "pnpm build && vsce package",
    "prepare": "husky",
    "vscode:prepublish": "pnpm build"
  },
  "jest": {
    "collectCoverage": true,
    "coveragePathIgnorePatterns": [
      "dist"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.tsx?$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ],
    "testPathIgnorePatterns": [
      "/dist/",
      "/node_modules/"
    ],
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^vscode$": "<rootDir>/__mocks__/vscode.ts"
    }
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "openai": "^6.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.0"
  }
}
